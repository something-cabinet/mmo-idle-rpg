# Copy to .env, .env.development and .env.production as needed.
# Vite loads .env, then the file for the current mode on top of it.

# --- .env (every mode) ---
# SpacetimeAuth client ID (dashboard -> Clients). Leave unset for guest-only.
# Must also be listed in OIDC_CLIENT_IDS in spacetimedb/src/config.ts.
# VITE_SPACETIMEAUTH_CLIENT_ID=client_XXXXXXXXXXXXXXXXXXXXXX

# Item art generation (`npm run art:gen`, scripts/item-art.ts). Never commit the real key.
# OPENROUTER_API_KEY=sk-or-v1-...
# ART_MODEL=google/gemini-3.1-flash-lite-image
# Finished sheet every new sheet copies the style of (art-src/sheets/<name>.png).
# ART_STYLE_REF=dagger

# --- .env.development (`npm run dev`, after `npm run spacetime:start`) ---
# VITE_SPACETIMEDB_HOST=ws://localhost:3000
# VITE_SPACETIMEDB_DB_NAME=mmo-idle-rpg

# --- .env.production (`npm run build`, Maincloud free tier) ---
# VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
# VITE_SPACETIMEDB_DB_NAME=<your-unique-db-name>
