{
  "name": "mmo-idle-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p spacetimedb",
    "server:install": "npm --prefix spacetimedb install",
    "spacetime:start": "spacetime start",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "tsx scripts/publish-local.ts",
    "spacetime:publish:local:reset": "tsx scripts/publish-local.ts --delete-data",
    "spacetime:logs:local": "spacetime logs --server local mmo-idle-rpg",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud",
    "deploy": "tsx scripts/deploy.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:data": "tsx scripts/check-data.ts",
    "test:combat": "tsx scripts/check-combat.ts",
    "test:loot": "tsx scripts/check-loot.ts",
    "test:equip": "tsx scripts/check-equip.ts",
    "test:craft": "tsx scripts/check-craft.ts",
    "test:sim": "tsx scripts/check-sim.ts",
    "test:encounters": "tsx scripts/check-encounters.ts",
    "test:duel": "tsx scripts/check-duel.ts",
    "test:raid": "tsx scripts/check-raid.ts"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spacetimedb": "^2.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
